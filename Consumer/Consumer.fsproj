<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Sample.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" Version="11.1.0" />
    <PackageReference Update="FSharp.Core" Version="10.1.401" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CtrfReport" Version="1.0.0-alpha.26527.6" />
  </ItemGroup>
  <ItemGroup>
    <!-- <ProjectReference Include="../Expecto.MTP/Expecto.MTP.fsproj" /> -->
    <PackageReference Include="Expecto.MTP" Version="*-test*" />
  </ItemGroup>


  <PropertyGroup>
    <!-- 
      Pack Expecto.MTP by default, allowing us to run this project independently, but allow us to optionally skip packing so tests don't re-pack on every run
      skip packing example `dotnet run -project ./Consumer -p SkipPack=True` 
      note: for some reason the xml comment is going wild if i add a double dash so you'll just have to add the other dash before project
     -->
    <SkipPack Condition="'$(SkipPack)'==''">False</SkipPack>
    <SkipPack Condition="'$(SkipPack)'!='False'">True</SkipPack>
  </PropertyGroup>
  <Target Name="PackBeforeBuild" BeforeTargets="Build" Condition="'$(SkipPack)'=='False'">
    <PropertyGroup>
      <VersionSuffix>test$([System.DateTime]::Now.ToString("yyyyMMddhhmmss"))</VersionSuffix>
    </PropertyGroup>
    <ItemGroup>
      <OldPackages Include="$(ProjectDir)/../local-nuget/*.nupkg" />
    </ItemGroup>
    <Delete Files="@(OldPackages)" />
    <Exec Command="dotnet pack $(ProjectDir)/../Expecto.MTP -o $(ProjectDir)/../local-nuget --version-suffix $(VersionSuffix)" />
  </Target>
</Project>
